{
  "name": "leveil-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sitemap": "node scripts/generate-sitemap.mjs",
    "images": "node scripts/generate-image-variants.mjs",
    "prebuild": "npm run validate:links && npm run validate:inbound && npm run sitemap && npm run images",
    "dev": "vite",
    "build": "tsc && vite-react-ssg build && node scripts/optimize-html.mjs",
    "preview": "vite preview",
    "new-post": "node scripts/new-post.js",
    "build-content": "node scripts/build-content.js",
    "deploy": "node scripts/deploy.js",
    "validate:article": "npx tsx scripts/validate-article.ts",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:inbound": "node scripts/validate-inbound-links.mjs"
  },
  "dependencies": {
    "@netlify/functions": "^4.2.2",
    "@vercel/og": "^0.8.5",
    "framer-motion": "^12.23.12",
    "fuse.js": "^6.6.2",
    "gsap": "^3.13.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lenis": "^1.3.23",
    "lucide-react": "^0.263.1",
    "motion": "^12.23.12",
    "ogl": "^1.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.8.1",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "beasties": "^0.1.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vite-react-ssg": "^0.9.1-beta.1",
    "workbox-window": "^7.0.0"
  }
}
