{
  "name": "petit-eveille-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Moteur vidéo Remotion — Le Petit Éveillé (TikTok). Isolé du site.",
  "scripts": {
    "studio": "remotion studio src/Root.tsx",
    "render": "remotion render src/Root.tsx Habitudes out/habitudes.mp4 --props=src/data/scripts/habitudes.json",
    "render:court": "remotion render src/Root.tsx Habitudes out/habitudes-court.mp4 --props=src/data/scripts/habitudes-court.json",
    "render:fx": "remotion render src/Root.tsx Habitudes out/fx-sprint2.mp4 --props=src/data/scripts/fx-sprint2.json",
    "render:fx3": "remotion render src/Root.tsx Habitudes out/fx-sprint3.mp4 --props=src/data/scripts/fx-sprint3.json",
    "render:tier2": "remotion render src/Root.tsx Habitudes out/fx-tier2.mp4 --props=src/data/scripts/fx-tier2.json",
    "render:icons": "remotion render src/Root.tsx Habitudes out/fx-icons.mp4 --props=src/data/scripts/fx-icons.json",
    "render:biais": "remotion render src/Root.tsx Habitudes out/biais-cognitifs.mp4 --props=src/data/scripts/biais-cognitifs.json",
    "render:anxiete": "remotion render src/Root.tsx Habitudes out/anxiete-amygdale.mp4 --props=src/data/scripts/anxiete-amygdale.json",
    "cover:anxiete": "remotion still src/Root.tsx Cover out/anxiete-amygdale-cover.png --props=src/data/covers/anxiete-amygdale.cover.json",
    "render:burnout": "remotion render src/Root.tsx Habitudes out/burnout.mp4 --props=src/data/scripts/burnout.json",
    "cover:burnout": "remotion still src/Root.tsx Cover out/burnout-cover.png --props=src/data/covers/burnout.cover.json",
    "banner": "remotion still src/Root.tsx Banner out/banner-youtube.png --props=src/data/covers/banner.json",
    "render:meditation": "remotion render src/Root.tsx Habitudes out/meditation.mp4 --props=src/data/scripts/meditation.json",
    "cover:meditation": "remotion still src/Root.tsx Cover out/meditation-cover.png --props=src/data/covers/meditation.cover.json",
    "render:intestin": "remotion render src/Root.tsx Habitudes out/intestin-cerveau.mp4 --props=src/data/scripts/intestin-cerveau.json",
    "cover:intestin": "remotion still src/Root.tsx Cover out/intestin-cerveau-cover.png --props=src/data/covers/intestin-cerveau.cover.json",
    "render:resilience": "remotion render src/Root.tsx Habitudes out/resilience.mp4 --props=src/data/scripts/resilience.json",
    "cover:resilience": "remotion still src/Root.tsx Cover out/resilience-cover.png --props=src/data/covers/resilience.cover.json",
    "render:bdnf": "remotion render src/Root.tsx Habitudes out/bdnf.mp4 --props=src/data/scripts/bdnf.json",
    "cover:bdnf": "remotion still src/Root.tsx Cover out/bdnf-cover.png --props=src/data/covers/bdnf.cover.json",
    "render:pensee": "remotion render src/Root.tsx Habitudes out/pensee-critique.mp4 --props=src/data/scripts/pensee-critique.json",
    "cover:pensee": "remotion still src/Root.tsx Cover out/pensee-critique-cover.png --props=src/data/covers/pensee-critique.cover.json",
    "render:demo": "remotion render src/Root.tsx Habitudes out/demo-features.mp4 --props=src/data/scripts/demo-features.json",
    "words:meditation": "py scripts/transcribe.py public/Méditation.mp3 --script src/data/scripts/meditation.json",
    "words:burnout": "py scripts/transcribe.py public/Burn-out.mp3 --script src/data/scripts/burnout.json",
    "words:anxiete": "py scripts/transcribe.py public/anxiete-amygdale.mp3 --script src/data/scripts/anxiete-amygdale.json",
    "words:biais": "py scripts/transcribe.py public/biais-cognitifs.mp3 --script src/data/scripts/biais-cognitifs.json",
    "words:habitudes": "py scripts/transcribe.py public/habitudes-court.mp3 --script src/data/scripts/habitudes-court.json",
    "words:intestin": "py scripts/transcribe.py public/intestin-cerveau.mp3 --script src/data/scripts/intestin-cerveau.json",
    "words:resilience": "py scripts/transcribe.py public/Résilience.mp3 --script src/data/scripts/resilience.json",
    "words:bdnf": "py scripts/transcribe.py public/BDNF.mp3 --script src/data/scripts/bdnf.json",
    "words:pensee": "py scripts/transcribe.py public/pensee-critique.mp3 --script src/data/scripts/pensee-critique.json",
    "smoke": "remotion render src/Root.tsx Smoke out/smoke.mp4",
    "ensure": "remotion browser ensure"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
